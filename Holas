--==================================================
-- ACTUALIZACIÓN
--==================================================

RunService.RenderStepped:Connect(function()

    local Character = LP.Character
    if not Character then
        return
    end

    local Humanoid =
        Character:FindFirstChildOfClass("Humanoid")

    local Root =
        Character:FindFirstChild("HumanoidRootPart")

    -- SPEED / JUMP / FREEZE
    if Humanoid then

        if Freeze then
            Humanoid.WalkSpeed = 0
            Humanoid.JumpPower = 0
        else
            Humanoid.WalkSpeed = Speed
            Humanoid.JumpPower = Jump
        end
    end

    --==================================================
    -- AIMBOT
    --==================================================

    if Aimbot then

        Target = GetClosestPlayer()

        if Target and Target.Character then

            local Head =
                Target.Character:FindFirstChild("Head")

            local TargetRoot =
                Target.Character:FindFirstChild("HumanoidRootPart")

            if Head and TargetRoot then

                -- Apuntar a la cabeza
                Camera.CFrame = CFrame.lookAt(
                    Camera.CFrame.Position,
                    Head.Position
                )

                -- Cuadro blanco
                if AimBox then
                    AimBox.Adornee = Target.Character
                end

                -- Línea
                if AimLine and Root then

                    LineA0 = Root:FindFirstChild("HOLD_JUP_LINE_START")

                    if not LineA0 then
                        LineA0 = Instance.new("Attachment")
                        LineA0.Name = "HOLD_JUP_LINE_START"
                        LineA0.Parent = Root
                    end

                    LineA1 = Head:FindFirstChild("HOLD_JUP_LINE_END")

                    if not LineA1 then
                        LineA1 = Instance.new("Attachment")
                        LineA1.Name = "HOLD_JUP_LINE_END"
                        LineA1.Parent = Head
                    end

                    AimLine.Attachment0 = LineA0
                    AimLine.Attachment1 = LineA1
                end

            end
        else

            if AimBox then
                AimBox.Adornee = nil
            end
        end

    end

    --==================================================
    -- PLATAFORMA
    --==================================================

    if Platform and Root then

        if not PlatformPart then

            PlatformPart = Instance.new("Part")
            PlatformPart.Name = "HOLD_JUP_PLATFORM"
            PlatformPart.Size = Vector3.new(7,0.5,7)
            PlatformPart.Anchored = true
            PlatformPart.CanCollide = true
            PlatformPart.Material = Enum.Material.Neon
            PlatformPart.Color = Color3.new(1,1,1)
            PlatformPart.Parent = workspace
        end

        PlatformPart.CFrame =
            Root.CFrame * CFrame.new(0,-3.2,0)

    end
end)

--==================================================
-- ARRASTRAR MENÚ
